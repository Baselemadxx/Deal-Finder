# =============================================================================
# Distress Deal Finder — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to git.
# =============================================================================

# --- App URL (used in email links to your leads) -----------------------------
# Locally: http://localhost:3000
# Production: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Dashboard & API Authentication (Required in Production) -----------------
# Shared secret used to protect the dashboard UI and all /api/* routes.
# Generate a random string (e.g. `openssl rand -hex 24`) and set it in Vercel.
DASHBOARD_TOKEN=change-me-to-a-long-random-secret

# --- Demo / Local Mode -------------------------------------------------------
# Set DEMO_MODE=true to run locally with a file-backed JSON database (.data/local-db.json)
# pre-seeded with realistic Metro Atlanta leads. No Supabase account needed to preview the UI.
# In production / CI (Vercel + GitHub Actions), set DEMO_MODE=false and configure Supabase below.
DEMO_MODE=true

# --- Database: Supabase Free Tier (PostgreSQL) -------------------------------
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email Alerts & Daily Briefing (No-Silent-Failure Guarantee) -------------
# Supported providers:
#   gmail   -> Gmail SMTP with an App Password (free: up to 500 emails/day, no domain required)
#   resend  -> Resend HTTP API (free: 100 emails/day, 3,000/month)
#   console -> Prints emails to stdout (for local development/testing only)
EMAIL_PROVIDER=console

# The inbox that receives daily briefings, high-score lead alerts, and error reports
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=Distress Deal Finder <you@gmail.com>

# Required if EMAIL_PROVIDER=gmail
# Create an App Password at https://myaccount.google.com/apppasswords (requires 2FA enabled)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Required if EMAIL_PROVIDER=resend
RESEND_API_KEY=

# --- Alerting & Scoring Thresholds -------------------------------------------
# Leads scoring at or above this threshold trigger an immediate individual email alert
HIGH_SCORE_ALERT_THRESHOLD=70

# --- Free-Tier LLM Chat Panel ------------------------------------------------
# Uses Google Gemini API Free Tier (https://aistudio.google.com/apikey — no credit card required)
# Swap models in ONE line by changing LLM_MODEL below.
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# --- Polite Scraper Tuning ---------------------------------------------------
# Minimum delay in milliseconds between outbound HTTP requests per host
SCRAPER_DELAY_MS=1500
# Request timeout in milliseconds
SCRAPER_TIMEOUT_MS=20000
# Set to true to run adapters and print results without writing to DB or sending real emails
DRY_RUN=false
